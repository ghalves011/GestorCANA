<?xml version="1.0" encoding="utf-8"?>
<!-- Soft white-to-blue radial glow behind the CANA badge, matching the
     desktop shortcut icon's look (plain white was too flat/plain). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:type="radial"
        android:gradientRadius="65%p"
        android:centerX="50%"
        android:centerY="50%"
        android:startColor="#FFFFFFFF"
        android:endColor="#FFC9D6FF" />
</shape>
